<Window x:Class="TrayChrome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tray Chrome"
        Height="640"
        Width="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Window.Resources>
        <!-- 鑷畾涔夋寜閽牱寮?-->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#666"/>
                                <Setter Property="Foreground" Value="#DDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- 澶栧眰瀹瑰櫒锛岀敤浜庡垱寤洪槾褰辨晥鏋?-->
    <Border x:Name="ShadowBorder" Background="#2D2D30" CornerRadius="8" Margin="10">
        <Border.Effect>
            <DropShadowEffect x:Name="ShadowEffect" Color="Black" Direction="0" ShadowDepth="0" Opacity="0.6" BlurRadius="15"/>
        </Border.Effect>
        
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <!-- 椤堕儴鍦板潃鏍?-->
        <Border Grid.Row="0" Name="TopToolbar" Background="#3C3C3C" BorderBrush="#555" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                
                <!-- 姹夊牎鑿滃崟鎸夐挳 -->
                <Label Grid.Column="0" Name="HamburgerMenu" 
                       Background="Transparent" Foreground="#FFFFFF"
                       Margin="2" 
                       Content="☰"
                       Cursor="SizeAll"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"/>
                
                <!-- 鍦板潃鏍?-->
                <TextBox Grid.Column="1" Name="AddressBar" 
                         Background="#444" Foreground="#FFFFFF" 
                         BorderThickness="0" BorderBrush="#888"
                         Margin="0,3,5,3" Padding="8,5" 
                         Text="https://tva.cornradio.org/?name=search"
                         KeyDown="AddressBar_KeyDown"
                         FontSize="10"
                         FontWeight="Normal"
                         VerticalContentAlignment="Center"/>

                <!-- 鍏抽棴鎸夐挳 -->
                <Button Grid.Column="2" Name="CloseButton" Content="×" 
                        Style="{StaticResource ToolbarButtonStyle}" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        
        <!-- WebView2 娴忚鍣ㄦ帶浠?-->
        <wv2:WebView2 Grid.Row="1" Name="webView"/>
        
        <!-- 搴曢儴鍔熻兘鎸夐挳鏍?-->
        <Border Grid.Row="2" Name="BottomToolbar" Background="#3C3C3C" BorderBrush="#555" BorderThickness="0,1,0,0">
            <Grid>
                <!-- 宸ュ叿鏍忔寜閽綉鏍?-->
                <Grid Name="ToolbarButtonsGrid" Margin="5,5,56,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Name="OpacityButton" Content="◐"
                            Style="{StaticResource ToolbarButtonStyle}" Click="OpacityButton_Click"
                            ToolTip="设置当前域名透明度"/>

                    <!-- 后退按钮 -->
                    <Button Grid.Column="1" Name="BackButton" Content="‹"
                            Style="{StaticResource ToolbarButtonStyle}" Click="BackButton_Click"
                            MouseRightButtonUp="BackButton_RightClick"/>
                    
                    <!-- 前进按钮 -->
                    <Button Grid.Column="2" Name="ForwardButton" Content="›"
                            Style="{StaticResource ToolbarButtonStyle}" Click="ForwardButton_Click"
                            MouseRightButtonUp="ForwardButton_RightClick"/>
                    
                    <!-- 刷新按钮 -->
                    <Button Grid.Column="3" Name="RefreshButton" Content="⟳"
                            Style="{StaticResource ToolbarButtonStyle}" Click="RefreshButton_Click"/>
                    
                    <!-- 收藏夹按钮 -->
                    <Button Grid.Column="4" Name="BookmarkButton" Content="★"
                            Style="{StaticResource ToolbarButtonStyle}" Click="BookmarkButton_Click"
                            ToolTip="收藏夹">
                        <Button.ContextMenu>
                            <ContextMenu Name="BookmarkContextMenu">
                                <MenuItem Header="添加到收藏夹" Click="AddBookmark_Click"/>
                                <MenuItem Header="书签管理器" Click="ShowSettings_Bookmarks_Click"/>
                                <Separator Name="BookmarkSeparator"/>
                                <!-- 鍔ㄦ€佹坊鍔犵殑鏀惰棌椤瑰皢鍦ㄨ繖閲?-->
                                <Separator Name="DynamicSeparatorEnd" Visibility="Collapsed"/>
                                <Separator/>
                                <MenuItem Header="open bookmark.json" Click="EditBookmarkJson_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    
                    <!-- UA切换按钮 -->
                    <Button Grid.Column="7" Name="UAButton" Content="▯"
                            Style="{StaticResource ToolbarButtonStyle}" Click="UAButton_Click"
                            ToolTip="切换用户代理 (当前: 手机)"/>
                    <!-- Popup按钮 -->
                    <Button Grid.Column="6" Name="PopupButton" Content="⫘"
                            Style="{StaticResource ToolbarButtonStyle}" Click="PopupButton_Click"
                            ToolTip="在新标签页打开"/>
                        <!-- 日夜模式切换按钮 -->
                    <Button Grid.Column="5" Name="DarkModeButton" Content="☾"
                            Style="{StaticResource ToolbarButtonStyle}" Click="DarkModeButton_Click"
                            ToolTip="切换暗色模式"/>

                    <!-- 浠ｇ悊鎸夐挳 -->
                    <Button Grid.Column="8" Name="ProxyButton" 
                            Style="{StaticResource ToolbarButtonStyle}" Click="ProxyButton_Click"
                            ToolTip="代理设置">
                        <Button.Content>
                            <Grid Width="14" Height="14">
                                <Ellipse Name="ProxyRing" Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                            </Grid>
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="开启/关闭代理" Click="ProxyToggle_Click" IsCheckable="True" Name="ProxyToggleMenuItem2"/>
                                <MenuItem Header="代理设置页面" Click="ProxySettings_Click"/>
                                <MenuItem Header="重启实例 (应用Proxy)" Click="RestartApp_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- 缃《鎸夐挳 -->
                    <Button Grid.Column="9" Name="TopMostButton" Content="📌" 
                            Style="{StaticResource ToolbarButtonStyle}" Click="TopMostButton_Click"
                            ToolTip="取消置顶"/>
                            
                    <!-- 鎷栧姩鎸夐挳 -->
                    <Label Grid.Column="12" Name="DragButton" Content="" 
                           Background="Transparent" Foreground="White"
                           FontSize="16" Cursor="SizeAll"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           ToolTip="拖拽移动窗口"/>
                           
                    <!-- 缂╁皬鎸夐挳 -->
                    <Button Grid.Column="10" Name="ZoomOutButton" Content="-" 
                            Style="{StaticResource ToolbarButtonStyle}" Click="ZoomOut_Click"
                            ToolTip="缩小"/>
                    <!-- 鏀惧ぇ鎸夐挳 -->
                    <Button Grid.Column="11" Name="ZoomInButton" Content="+" 
                            Style="{StaticResource ToolbarButtonStyle}" Click="ZoomIn_Click"
                            ToolTip="放大"/>
                </Grid>
                
                <!-- 淇濆瓨绐楀彛閰嶇疆鎸夐挳 -->
                <Button Name="SaveLayoutButton" Content="&#xE105;"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ToolbarButtonStyle}"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13" Width="24" Height="24"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="0" Margin="0,0,22,0"
                        Opacity="1"
                        Visibility="Visible"
                        Click="SaveLayoutButton_Click"
                        ToolTip="保存当前域名窗口配置"/>
                <Button Name="MoreButton" Content="⋯"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ToolbarButtonStyle}"
                        FontSize="16" Width="24" Height="24"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="0" Margin="0,0,46,0"
                        Visibility="Collapsed"
                        Click="MoreButton_Click"
                        ToolTip="更多操作"/>
                
                <!-- 绐楀彛璋冩暣鎸夐挳-濮嬬粓鍥哄畾鍦ㄥ彸涓嬭 -->
                <Label Name="ResizeButton" Content="↘"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Background="Transparent" Foreground="#aaa"
                       FontSize="14" Cursor="SizeNWSE" Width="24" Height="24"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       Padding="0" Margin="0,0,2,0"
                       ToolTip="拖拽调整窗口大小"/>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
